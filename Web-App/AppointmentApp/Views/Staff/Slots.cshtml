@model List<AppointmentApp.Models.AppointmentSlot>
@{
    ViewData["Title"] = "Time Slots";
}

<h1 class="mb-4">Time Slots</h1>

<a class="btn btn-primary mb-3" asp-action="CreateSlot">+ New Slot</a>

@if (!Model.Any())
{
    <div class="alert alert-info">No slots yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Start</th>
                <th>End</th>
                <th>Available</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Date.ToString("yyyy-MM-dd")</td>
                <td>@s.StartTime</td>
                <td>@s.EndTime</td>
                <td>
                    <span class="badge bg-@(s.IsAvailable == true ? "success" : "secondary")">
                        @(s.IsAvailable == true ? "Yes" : "No")
                    </span>
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="EditSlot" asp-route-id="@s.SlotId">Edit</a>

                    <form method="post" asp-action="DeleteSlot" asp-route-id="@s.SlotId"
                          class="d-inline"
                          onsubmit="return confirm('Delete this slot?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}