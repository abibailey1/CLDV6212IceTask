@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Appointment App</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Account" asp-action="Login">Appointment App</a>
            <div class="navbar-nav">
                @if (isLoggedIn)
                {
                    if (role == "staff")
                    {
                        <a class="nav-link" asp-controller="Staff" asp-action="Dashboard">Appointments</a>
                        <a class="nav-link" asp-controller="Staff" asp-action="Slots">Slots</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="Patient" asp-action="Dashboard">My Appointments</a>
                        <a class="nav-link" asp-controller="Patient" asp-action="Book">Book</a>
                    }
                    <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
            @if (isLoggedIn)
            {
                <span class="navbar-text text-light">
                    Signed in as @User.Identity!.Name (@role)
                </span>
            }
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="text-muted text-center mt-5 mb-3">
        &copy; @DateTime.Now.Year — Appointment App
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>