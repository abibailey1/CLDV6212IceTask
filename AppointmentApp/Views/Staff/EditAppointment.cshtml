@model AppointmentApp.Models.Appointment
@{
    ViewData["Title"] = "Edit Appointment";
    var slots = ViewBag.Slots as List<AppointmentApp.Models.AppointmentSlot>;
}

<h1 class="mb-4">Edit Appointment</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-action="EditAppointment" asp-route-id="@Model.AppointmentId">

            <div class="mb-3">
                <label class="form-label">Patient ID</label>
                <input class="form-control" value="@Model.UserId" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Date</label>
                <input class="form-control" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Slot</label>
                <select name="slotId" class="form-select">
                    @if (slots != null)
                    {
                        foreach (var s in slots)
                        {
                            <option value="@s.SlotId" selected="@(s.SlotId == Model.SlotId)">
                                @s.Date.ToString("yyyy-MM-dd") — @s.StartTime to @s.EndTime
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="Booked" selected="@(Model.Status == "Booked")">Booked</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                    <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-secondary" asp-action="Dashboard">Cancel</a>
        </form>
    </div>
</div>